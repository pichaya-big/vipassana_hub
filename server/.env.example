PORT=4000
# MongoDB connection string. Include authSource if the user was created in the admin database.
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/vipassana-hub?authSource=admin
# Comma-separated list of allowed browser origins (only needed if the client calls the API cross-origin)
CORS_ORIGIN=http://localhost,http://localhost:3000
# Signs login sessions. Use a long random string (32+ chars).
JWT_SECRET=
# Minimum log level written: fatal, error, warn, info, debug, trace, silent. Default info.
LOG_LEVEL=info
# Folder where uploaded lesson videos are stored (default: uploads/ inside the server folder)
UPLOAD_DIR=uploads
# Largest video that can be uploaded, in MB. nginx limit in proxy/nginx.conf must be at least this.
MAX_VIDEO_MB=50
